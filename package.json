{
  "name": "poe2-builds",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "data:sync": "node scripts/sync-data.mjs",
    "builds:check": "tsx --conditions=react-server scripts/validate-builds.ts",
    "builds:fit": "tsx --conditions=react-server scripts/fit-passives.ts",
    "builds:weapon-sets": "tsx --conditions=react-server scripts/weapon-sets.ts",
    "test:planner": "tsx scripts/test-planner.ts",
    "research:maxroll": "node scripts/research-maxroll.cjs",
    "draft:maxroll": "node scripts/draft-from-maxroll.cjs",
    "runes:maxroll": "node scripts/runes-from-maxroll.cjs",
    "runes:names": "node scripts/rune-names.mjs",
    "leveling:maxroll": "node scripts/leveling-from-maxroll.cjs",
    "ladder:sync": "node scripts/sync-ninja.mjs",
    "meta:history": "node scripts/sync-meta-history.mjs",
    "prices:sync": "node scripts/sync-prices.mjs",
    "sources:check": "node scripts/check-sources.mjs",
    "data:refresh": "node scripts/sync-ninja.mjs && node scripts/sync-prices.mjs && node scripts/sync-loot.mjs && node scripts/sync-meta-history.mjs && node scripts/check-sources.mjs",
    "craft:data": "node scripts/craft-data.mjs",
    "currency:data": "node scripts/currency-data.mjs",
    "atlas:data": "node scripts/atlas-data.mjs",
    "skills:granted": "node scripts/granted-skills.mjs",
    "draft:ninja": "node scripts/draft-from-ninja.mjs",
    "draft:pob": "node scripts/draft-from-pob.mjs",
    "loot:sync": "node scripts/sync-loot.mjs",
    "trade:stats": "node scripts/trade-stats.mjs",
    "trees:maxroll": "tsx --conditions=react-server scripts/trees-from-maxroll.ts",
    "preview": "next build && next start"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.1.3",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dds-ktx-parser": "^2.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
